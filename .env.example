# ---------------------------------------------------------------------------
# Heart2Heart Foundation — frontend environment
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical URLs, the PWA manifest and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the NestJS API. While unset, the app serves its own Next.js
# route handlers backed by the in-memory demo store in src/lib/data.
# NEXT_PUBLIC_API_URL=https://api.heart2heart.ng

# Session signing secret for the staff portal (server-side only).
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-in-production

# Verified emergency helpline shown in the "Need help now?" pathway.
# These must be confirmed with the Foundation before going live.
NEXT_PUBLIC_EMERGENCY_HELPLINE=+2348000000000
NEXT_PUBLIC_EMERGENCY_WHATSAPP=+2348000000000

# Payment provider (select per Nigerian payment/regulatory requirements).
# NEXT_PUBLIC_PAYMENT_PROVIDER=paystack
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=
